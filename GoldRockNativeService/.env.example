# No secret is included. Never commit a real .env.local file.
GOLDROCK_ENV=development
GOLDROCK_HOST=127.0.0.1
GOLDROCK_PORT=4390
GOLDROCK_ORIGIN=http://127.0.0.1:4390
GOLDROCK_JOB_TTL_SECONDS=900
# Explicit cloud configuration; use synthetic records until real-data readiness is approved.
OPENAI_API_KEY=
OPENAI_MODEL=
GOLDROCK_ENABLE_CLOUD=0
GOLDROCK_PROVIDER_RETENTION_NOTICE=Cloud guidance is not configured. No information is sent to a model.
# Production requires a stable private 32-byte encryption key encoded as 64 hex characters.
GOLDROCK_DATA_KEY=
